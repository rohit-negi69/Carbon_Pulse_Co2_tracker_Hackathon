# CarbonPulse backend configuration — copy to .env and fill in what you need.
# Everything is optional; with no env vars the app runs fully on in-memory
# storage + the rule-based copilot.

# --- LLM provider (pick ONE; Ollama wins if both are set) ------------------

# Ollama Cloud — key from ollama.com → Settings → Keys
OLLAMA_API_KEY=
# Cloud model, e.g. gpt-oss:120b, gpt-oss:20b, qwen3-coder:480b, deepseek-v3.1:671b, gemma3:27b
OLLAMA_MODEL=gpt-oss:120b
# Cloud endpoint (default). For a local Ollama server use http://localhost:11434/v1
OLLAMA_BASE_URL=https://ollama.com/v1

# OR classic OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Database ---------------------------------------------------------------

# MongoDB Atlas connection string. Unset → in-memory store (data resets on restart).
MONGODB_URI=

# --- Misc (all optional) ----------------------------------------------------

# CORS origin of the deployed frontend
CLIENT_ORIGIN=http://localhost:5173
# Real-time ticker cadence and grid-intensity region
REALTIME_TICK_MS=4000
GRID_REGION=IN
