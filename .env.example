[TEMPLATE]
# Server configuration
PORT=3000
CLIENT_ORIGIN=*

# Storage (Optional — app defaults to full in-memory store if unset)
MONGODB_URI=

# Optional AI Copilot providers (Rule-based copilot always works without any key)
# Ollama takes precedence when both Ollama and OpenAI are configured.
#   Ollama Cloud: key from ollama.com -> Settings -> Keys (base URL https://ollama.com/v1)
#   Local Ollama: set OLLAMA_BASE_URL=http://localhost:11434/v1 — no API key required
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Optional external notification & data services
RESEND_API_KEY=
NOTIFY_EMAIL=
CARBON_DATA_API_KEY=
GEO_API_KEY=

# Real-time settings
REALTIME_TICK_MS=4000
GRID_REGION=IN

# Client-side (Optional, defaults to relative /api)
VITE_API_URL=
